{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCIR Checkpoint Closeout Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "queue_state",
    "last_completed",
    "next_action",
    "validation_state",
    "decision_record_refs",
    "evidence_refs",
    "validation_context",
    "superseded_dirty_checkpoint",
    "residual_risks",
    "reentry_conditions"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "queue_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ready_items",
        "no_successor_item_reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "READY",
            "EMPTY_BY_DESIGN"
          ]
        },
        "ready_items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Q-[0-9]{2}-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "no_successor_item_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "last_completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_id",
        "label",
        "title"
      ],
      "properties": {
        "queue_id": {
          "type": "string",
          "pattern": "^Q-[0-9]{2}-[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "next_action": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "queue_id",
        "title"
      ],
      "properties": {
        "queue_id": {
          "type": "string",
          "pattern": "^Q-[0-9]{2}-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "synchronized_with_working_tree"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASSED",
            "FAILED"
          ]
        },
        "synchronized_with_working_tree": {
          "type": "boolean"
        }
      }
    },
    "decision_record_refs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "transition",
          "evidence_references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DR-[0-9]{3}$"
          },
          "transition": {
            "type": "string",
            "minLength": 1
          },
          "evidence_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_markdown",
        "queue_export",
        "relevant_plan_closeouts",
        "validation_outputs",
        "schema_or_contract_surfaces"
      ],
      "properties": {
        "queue_markdown": {
          "$ref": "#/$defs/file_ref"
        },
        "queue_export": {
          "$ref": "#/$defs/generated_file_ref"
        },
        "relevant_plan_closeouts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "section",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "validation_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "status"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed"
                ]
              }
            }
          }
        },
        "schema_or_contract_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file_ref"
          }
        }
      }
    },
    "validation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_snapshot",
        "head_commit_hash",
        "commit_hash_basis",
        "working_tree_dirty",
        "working_tree_status",
        "validation_commands",
        "schema_versions",
        "exported_artifacts"
      ],
      "properties": {
        "queue_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "head_commit_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_hash_basis": {
          "type": "string",
          "enum": [
            "current_head",
            "baseline_parent"
          ]
        },
        "working_tree_dirty": {
          "type": "boolean"
        },
        "working_tree_status": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "schema_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "declared_version",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "declared_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "exported_artifacts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/generated_file_ref"
          }
        }
      }
    },
    "superseded_dirty_checkpoint": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "generated_at",
        "artifact_sha256",
        "head_commit_hash",
        "commit_hash_basis",
        "working_tree_dirty",
        "working_tree_status"
      ],
      "properties": {
        "generated_at": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "head_commit_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_hash_basis": {
          "type": "string",
          "enum": [
            "current_head",
            "baseline_parent"
          ]
        },
        "working_tree_dirty": {
          "type": "boolean",
          "const": true
        },
        "working_tree_status": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reentry_conditions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "generated_file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "generated_at",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
