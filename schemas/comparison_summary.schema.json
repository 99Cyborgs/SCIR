{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCIR Baseline Comparison Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sweep_id",
    "run_id",
    "commit_sha",
    "spec_version",
    "tool_version",
    "corpus_id",
    "corpus_manifest_hash",
    "generated_at",
    "comparison_metrics",
    "aggregate",
    "slices",
    "tolerance_failures",
    "contamination_flags"
  ],
  "properties": {
    "sweep_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "comparison_metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "LCR",
          "GR",
          "SE",
          "SCPR",
          "round_trip",
          "LCR_scirhc",
          "GR_scirhc",
          "SCPR_scirhc"
        ]
      }
    },
    "aggregate": {
      "$ref": "#/$defs/comparisonAggregate"
    },
    "slices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparisonSlice"
      }
    },
    "tolerance_failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toleranceFailure"
      }
    },
    "contamination_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "track_evaluations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/trackEvaluation"
        },
        "B": {
          "$ref": "#/$defs/trackEvaluation"
        }
      }
    },
    "continuation_decision": {
      "$ref": "#/$defs/continuationDecision"
    }
  },
  "$defs": {
    "metricSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "LCR",
        "GR",
        "SE",
        "SCPR",
        "round_trip",
        "LCR_scirhc",
        "GR_scirhc",
        "SCPR_scirhc"
      ],
      "properties": {
        "LCR": {
          "type": [
            "number",
            "null"
          ]
        },
        "GR": {
          "type": [
            "number",
            "null"
          ]
        },
        "SE": {
          "type": [
            "number",
            "null"
          ]
        },
        "SCPR": {
          "type": [
            "number",
            "null"
          ]
        },
        "round_trip": {
          "type": [
            "number",
            "null"
          ]
        },
        "LCR_scirhc": {
          "type": [
            "number",
            "null"
          ]
        },
        "GR_scirhc": {
          "type": [
            "number",
            "null"
          ]
        },
        "SCPR_scirhc": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "comparisonAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scir_metrics",
        "delta_vs_source",
        "delta_vs_ast",
        "delta_vs_normalized"
      ],
      "properties": {
        "scir_metrics": {
          "$ref": "#/$defs/metricSnapshot"
        },
        "delta_vs_source": {
          "$ref": "#/$defs/metricSnapshot"
        },
        "delta_vs_ast": {
          "$ref": "#/$defs/metricSnapshot"
        },
        "delta_vs_normalized": {
          "$ref": "#/$defs/metricSnapshot"
        }
      }
    },
    "comparisonSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "scir_metrics",
        "delta_vs_source",
        "delta_vs_ast",
        "delta_vs_normalized"
      ],
      "properties": {
        "slice_id": {
          "type": "string",
          "minLength": 1
        },
        "scir_metrics": {
          "$ref": "#/$defs/metricSnapshot"
        },
        "delta_vs_source": {
          "$ref": "#/$defs/metricSnapshot"
        },
        "delta_vs_ast": {
          "$ref": "#/$defs/metricSnapshot"
        },
        "delta_vs_normalized": {
          "$ref": "#/$defs/metricSnapshot"
        }
      }
    },
    "toleranceFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "baseline_name",
        "metric",
        "delta",
        "tolerance"
      ],
      "properties": {
        "slice_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_name": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "enum": [
          "LCR",
          "GR",
          "SE",
          "SCPR",
          "round_trip",
          "LCR_scirhc",
          "GR_scirhc",
          "SCPR_scirhc"
        ]
      },
        "delta": {
          "type": "number"
        },
        "tolerance": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "surfaceEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "strongest_baseline_name",
        "metric",
        "direction",
        "scir_value",
        "strongest_baseline_value",
        "delta",
        "tie_tolerance",
        "outcome",
        "threshold_summary",
        "supporting_metric",
        "supporting_value"
      ],
      "properties": {
        "surface_id": {
          "type": "string",
          "minLength": 1
        },
        "strongest_baseline_name": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "lower",
            "higher"
          ]
        },
        "scir_value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "strongest_baseline_value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "delta": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "tie_tolerance": {
          "type": [
            "number",
            "null"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "win",
            "tie",
            "loss",
            "inconclusive"
          ]
        },
        "threshold_summary": {
          "type": "string",
          "minLength": 1
        },
        "supporting_metric": {
          "type": [
            "string",
            "null"
          ]
        },
        "supporting_value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        }
      }
    },
    "trackEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track",
        "track_status",
        "decision_signal",
        "win_count",
        "tie_count",
        "loss_count",
        "surface_evaluations"
      ],
      "properties": {
        "track": {
          "type": "string",
          "enum": [
            "A",
            "B"
          ]
        },
        "track_status": {
          "type": "string",
          "enum": [
            "pass",
            "mixed",
            "fail"
          ]
        },
        "decision_signal": {
          "type": "string",
          "enum": [
            "win",
            "tie",
            "loss",
            "inconclusive"
          ]
        },
        "win_count": {
          "type": "integer",
          "minimum": 0
        },
        "tie_count": {
          "type": "integer",
          "minimum": 0
        },
        "loss_count": {
          "type": "integer",
          "minimum": 0
        },
        "surface_evaluations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surfaceEvaluation"
          }
        }
      }
    },
    "continuationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "claim_ready",
        "strongest_counterexample_baseline",
        "strongest_counterexample_surface",
        "reasons"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "SCIR_NECESSARY",
            "SCIR_USEFUL_BUT_UNNECESSARY",
            "SCIR_NOT_JUSTIFIED",
            "INCONCLUSIVE"
          ]
        },
        "claim_ready": {
          "type": "boolean"
        },
        "strongest_counterexample_baseline": {
          "type": [
            "string",
            "null"
          ]
        },
        "strongest_counterexample_surface": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
