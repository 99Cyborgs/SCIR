{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCIR Decision Register Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisions",
    "decision_records"
  ],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "decision",
          "constraint_imposed",
          "reversible",
          "first_validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "pending",
              "superseded",
              "rejected"
            ]
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "constraint_imposed": {
            "type": "string",
            "minLength": 1
          },
          "reversible": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "partly"
            ]
          },
          "first_validation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "transition",
          "justification",
          "evidence_references",
          "reversibility",
          "residual_risk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DR-[0-9]{3}$"
          },
          "transition": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "evidence_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reversibility": {
            "type": "string",
            "minLength": 1
          },
          "residual_risk": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
