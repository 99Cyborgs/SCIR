{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCIR Execution Queue Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation_timestamp",
    "active_milestone",
    "autonomy_mode",
    "source_documents",
    "queue_items",
    "current_queue_state",
    "reentry_conditions",
    "blocking_open_questions",
    "next_action",
    "escalation_threshold"
  ],
  "properties": {
    "generation_timestamp": {
      "type": "string",
      "minLength": 1
    },
    "active_milestone": {
      "type": "string",
      "minLength": 1
    },
    "autonomy_mode": {
      "type": "string",
      "enum": [
        "high",
        "moderate",
        "conservative"
      ]
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "queue_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue_id",
          "title",
          "source_milestone_or_phase",
          "status",
          "why_now",
          "prerequisites",
          "work_instructions",
          "touched_surfaces",
          "validation",
          "escalate_only_if",
          "done_evidence",
          "blocking_open_questions"
        ],
        "properties": {
          "queue_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_milestone_or_phase": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "blocked",
              "in-progress",
              "done",
              "deferred"
            ]
          },
          "why_now": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "work_instructions": {
            "type": "string",
            "minLength": 1
          },
          "touched_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "escalate_only_if": {
            "type": "string",
            "minLength": 1
          },
          "done_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocking_open_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^OQ-[0-9]{3}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "current_queue_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_items",
        "queue_state",
        "last_completed",
        "no_successor_item_reason",
        "queue_status"
      ],
      "properties": {
        "ready_items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Q-[0-9]{2}-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "queue_state": {
          "type": "string",
          "enum": [
            "READY",
            "EMPTY_BY_DESIGN"
          ]
        },
        "last_completed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queue_id",
            "label"
          ],
          "properties": {
            "queue_id": {
              "type": "string",
              "pattern": "^Q-[0-9]{2}-[0-9]{3}$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "no_successor_item_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "queue_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "synchronized_with_working_tree",
            "validation_state"
          ],
          "properties": {
            "synchronized_with_working_tree": {
              "type": "boolean"
            },
            "validation_state": {
              "type": "string",
              "enum": [
                "PENDING",
                "PASSED",
                "FAILED"
              ]
            }
          }
        }
      }
    },
    "reentry_conditions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blocking_open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OQ-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "next_action": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "queue_id",
        "title"
      ],
      "properties": {
        "queue_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "escalation_threshold": {
      "type": "string",
      "minLength": 1
    }
  }
}
